include .gitattributes LICENSE README.md README_LOAD.md README_MAR.md README_NICHE.md README_RONA.md INSTALL.md INPUTS.md ARCHITECTURE.md CHANGELOG.md CONTRIBUTING.md
include architecture.dot architecture.svg architecture.png
include environment.yml environment-plot.yml conda-lock.yml
# Only portable example profiles belong in a public archive.  Keep every
# server/regression profile out even if a future file is given a new name.
exclude workflow.*.ini
include workflow.example.ini workflow.*.example.ini
recursive-include bin *
recursive-include bioma/scripts *.R *.py
recursive-include tests *.py *.R
recursive-include tests/data/demo *.py *.md *.json *.tsv *.vcf *.prune.in
recursive-include tests/data/gf_frequency_50 *.tsv *.json *.vcf
global-exclude __pycache__/*
global-exclude *.py[cod]
global-exclude *.tgz
global-exclude *.tar.gz
global-exclude *.zip
global-exclude *.whl
# Scientific rasters and production genotype/geospatial datasets must be
# supplied by the operator, never bundled into the source distribution.
global-exclude *.vcf.gz
global-exclude *.tif
global-exclude *.tiff
global-exclude *.shp
global-exclude *.dbf
global-exclude *.shx
